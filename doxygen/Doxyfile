# InsightPC Doxygen configuration
PROJECT_NAME           = "InsightPC"
PROJECT_BRIEF          = "Cross-platform system information visualizer built with JavaFX and OSHI"
PROJECT_NUMBER         = "1.0.0"
OUTPUT_DIRECTORY       = docs-gen
CREATE_SUBDIRS         = NO
OUTPUT_LANGUAGE        = English

INPUT                  = README.md \
                         src/main/java \
                         doxygen/packages.dox \
                         doxygen/pages
RECURSIVE              = YES
FILE_PATTERNS          = *.java \
                         *.md \
                         *.dox
EXCLUDE                = target \
                         build \
                         docs-gen \
                         src/test \
                         readme \
                         .git
EXCLUDE_PATTERNS       = */target/* \
                         */build/* \
                         */docs-gen/* \
                         */src/test/* \
                         */readme/* \
                         */screenshots/*
IMAGE_PATH             = readme doxygen/pages
USE_MDFILE_AS_MAINPAGE = README.md
TOC_INCLUDE_HEADINGS   = 0

OPTIMIZE_OUTPUT_JAVA   = YES
EXTENSION_MAPPING      = java=Java
JAVADOC_AUTOBRIEF      = YES
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = YES
EXTRACT_PRIV_VIRTUAL   = YES
EXTRACT_PACKAGE        = YES
EXTRACT_STATIC         = YES
EXTRACT_LOCAL_CLASSES  = YES
EXTRACT_LOCAL_METHODS  = YES
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO
INHERIT_DOCS           = YES
SOURCE_BROWSER         = YES
INLINE_SOURCES         = YES
STRIP_CODE_COMMENTS    = NO
REFERENCED_BY_RELATION = YES
REFERENCES_RELATION    = YES
REFERENCES_LINK_SOURCE = YES

GENERATE_HTML          = YES
HTML_OUTPUT            = html
HTML_COLORSTYLE        = LIGHT
HTML_DYNAMIC_MENUS     = YES
HTML_DYNAMIC_SECTIONS  = YES
HTML_EXTRA_STYLESHEET  = doxygen/custom.css
HTML_EXTRA_FILES       = doxygen/custom.js
HTML_FOOTER            = doxygen/footer.html
GENERATE_TREEVIEW      = YES
FULL_SIDEBAR           = NO
DISABLE_INDEX          = NO
SEARCHENGINE           = YES
SERVER_BASED_SEARCH    = NO

HAVE_DOT               = YES
DOT_IMAGE_FORMAT       = svg
INTERACTIVE_SVG        = YES
CLASS_GRAPH            = YES
COLLABORATION_GRAPH    = YES
GROUP_GRAPHS           = YES
DIRECTORY_GRAPH        = YES
CALL_GRAPH             = YES
CALLER_GRAPH           = YES
GRAPHICAL_HIERARCHY    = YES
UML_LOOK               = YES
TEMPLATE_RELATIONS     = YES
DOT_GRAPH_MAX_NODES    = 80
MAX_DOT_GRAPH_DEPTH    = 3
DOT_MULTI_TARGETS      = YES
DOT_CLEANUP            = YES

WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = NO
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = NO
QUIET                  = NO
