<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.SeparatorMenuItem?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.tlcsdm.insightpc.controller.MainController"
            prefWidth="1000" prefHeight="700">

    <top>
        <VBox>
            <HBox fx:id="titleBar" styleClass="custom-title-bar">
                <ImageView fx:id="titleBarIcon" fitHeight="16" fitWidth="16" pickOnBounds="true" preserveRatio="true"/>
                <Label fx:id="titleBarLabel" styleClass="custom-title-text"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button fx:id="minimizeButton" text="─" accessibleText="Minimize window" styleClass="window-control-button" onAction="#minimizeWindow"/>
                <Button fx:id="maximizeButton" text="□" accessibleText="Maximize window" styleClass="window-control-button" onAction="#toggleMaximizeWindow"/>
                <Button fx:id="closeButton" text="✕" accessibleText="Close window" styleClass="window-control-button" onAction="#exitApplication"/>
            </HBox>
            <MenuBar>
                <Menu text="%menu.file">
                    <MenuItem text="%menu.settings" onAction="#openSettings"/>
                    <SeparatorMenuItem/>
                    <MenuItem text="%menu.restart" onAction="#restartApplication"/>
                    <MenuItem text="%menu.exit" onAction="#exitApplication"/>
                </Menu>
                <Menu text="%menu.help">
                    <MenuItem text="%menu.about" onAction="#showAbout"/>
                </Menu>
            </MenuBar>
        </VBox>
    </top>

    <center>
        <TabPane fx:id="tabPane" tabClosingPolicy="UNAVAILABLE"/>
    </center>

</BorderPane>
